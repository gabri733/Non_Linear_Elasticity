/CLEAR,NOSTART
/TITLE, Mooney-Rivlin Cylinder - Pressione + Stretch assiale (Arc-Length + ARCTRM + Post-Proc)
/PREP7

! ============================================================
! 1. PARAMETRI E GEOMETRIA
! ============================================================
R_in  = 10.0      ! Raggio interno (mm)
R_out = 11.0      ! Raggio esterno (mm)
H     = 20.0      ! Altezza cilindro (mm)

P_in_max   = 0.01      ! Pressione interna finale (MPa) - riferimento per l'arc-length
lambda_z   = 1.5       ! Stretch assiale finale imposto
UY_top_max = (lambda_z-1)*H

C10   = 0.1       ! Costante C10 (MPa)
C01   = 0.5       ! Costante C01 (MPa)
D1    = 1.0E-4    ! Comprimibilita numerica (v ~ 0.4999)

RECTNG, R_in, R_out, 0, H

! ============================================================
! 2. ELEMENTO E MATERIALE
! ============================================================
ET,1,PLANE182
KEYOPT,1,3,1       ! Axisymmetric
KEYOPT,1,6,1       ! Mixed u-p formulation

TB,HYPER,1,1,2,MOONEY
TBDATA,1,C10,C01,D1

! ============================================================
! 3. MESH MAPPATA
! ============================================================
LSEL,S,LOC,Y,0
LESIZE,ALL,,,10
LSEL,S,LOC,Y,H
LESIZE,ALL,,,10
ALLSEL,ALL

LSEL,S,LOC,X,R_in
LESIZE,ALL,,,80
LSEL,S,LOC,X,R_out
LESIZE,ALL,,,80
ALLSEL,ALL

MSHKEY,1
AMESH,ALL

! ============================================================
! 4. NODO/ELEMENTO DI RIFERIMENTO PER ARCTRM E POST-PROCESSING
!    (superficie interna, a meta' altezza - lontano dagli effetti
!     di bordo su base e sommita')
! ============================================================
NSEL, S, LOC, X, R_in
NSEL, R, LOC, Y, H/2, H/2 + H/40
*GET, N_COUNT, NODE, 0, COUNT
*IF, N_COUNT, EQ, 0, THEN
    *MSG, ERROR, ' '
    Nessun nodo trovato nella fascia di riferimento: controlla H e la mesh.
*ENDIF
*GET, N_REF, NODE, 0, NUM, MIN
ALLSEL, ALL

NSEL, S, NODE, , N_REF
ESLN, S, 0
*GET, E_COUNT, ELEM, 0, COUNT
*IF, E_COUNT, EQ, 0, THEN
    *MSG, ERROR, ' '
    Nessun elemento trovato collegato a N_REF: controlla la mesh.
*ENDIF
*GET, E_REF, ELEM, 0, NUM, MIN
ALLSEL, ALL

! *STATUS, N_REF
! *STATUS, E_REF

! ============================================================
! 5. SOLUZIONE
! ============================================================
/SOLU
NLGEOM, ON
NROPT, FULL, , ON

! --- Vincolo base: UY = 0 alla base ---
LSEL, S, LOC, Y, 0
NSLL, S, 1
D, ALL, UY, 0
ALLSEL, ALL


! --- Criteri di convergenza ---
CNVTOL, F, , 0.005, 2, 0.01
CNVTOL, U, , 0.01, 2
NEQIT, 50
NCNV, 2
OUTPR, ALL, ALL
OUTRES, ESOL, ALL


! ============================================================
! LOAD STEP 2: attiva arc-length, sale SOLO la pressione
!              (lo stretch resta congelato al valore raggiunto)
============================================================
NSEL, S, LOC, Y , H
D, ALL, UY, UY_top_max
ALLSEL, ALL

LSEL, S, LOC, X, R_in
SFL, ALL, PRES, P_in_max
ALLSEL, ALL
OUTRES,ALL,ALL

ARCLEN, ON, 25, 0.0001     ! MAXFACTOR, MINFACTOR
                           ! Nota: LNSRCH/AUTOTS/PRED vengono disabilitati
                           ! automaticamente da ANSYS con un warning: e' atteso.
NSUBST, 30, 30, 30        ! NSBMX come rete di sicurezza indipendente da ARCTRM

! --- Criterio di arresto: ferma quando lo spostamento radiale (UX)
!     del nodo di riferimento supera 2 volte il raggio interno iniziale ---
ARCTRM, U, 100*R_in, N_REF, UX

SOLVE
FINISH

! ============================================================
! 6. POST-PROCESSING: curva tensione-deformazione al punto di riferimento
! ============================================================
! /POST26
! FILE, , rst

! NSOL, 2, N_REF, U, X, UX_REF                    ! spostamento radiale
! ESOL, 3, E_REF, N_REF, S, Z, SZ_hoop            ! tensione circonferenziale (vera)
! ESOL, 4, E_REF, N_REF, EPTO, Z, EZ_hoop         ! deformazione circonferenziale (vera)

! STORE, MERGE

! ! --- Grafico tensione vs deformazione ---
! /AXLAB, X, Deformazione logaritmica circonferenziale
! /AXLAB, Y, Tensione circonferenziale (MPa)
! XVAR, 2
! PLVAR, 3

! ! --- Valori numerici substep per substep ---
! PRVAR, 2, 3, 4

! FINISH


! /POST26 
! ESOL, 2, E_REF, N_REF, S, X, SR_true      ! radiale
! ESOL, 3, E_REF, N_REF, S, Y, SZ_true      ! assiale (Y = asse del cilindro)
! ESOL, 4, E_REF, N_REF, S, Z, ST_true      ! circonferenziale (hoop)
! ESOL, 5, E_REF, N_REF, S, XY, SXY_check   ! taglio: deve restare ~0

! ! --- Deformazione logaritmica (vera) -> stretch = exp(EPTO) ---
! ESOL, 6, E_REF, N_REF, EPEL, X, ER_log
! ESOL, 7, E_REF, N_REF, EPEL, Y, EZ_log
! ESOL, 8, E_REF, N_REF, EPEL, Z, ET_log

! ! --- Energia di deformazione (totale elemento) e volume ---
! ESOL, 9,  E_REF, N_REF, SEND, ENTO , SENE_el
! ESOL, 10, E_REF, N_REF, VOLU, , VOLU_el

! STORE, MERGE
! PRVAR, 2, 3, 4, 5, 6, 
! PRVAR, 7, 8, 9, 10

